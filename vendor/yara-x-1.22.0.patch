+#[cfg(test)]
+mod stable_rsa_tests {
+    use super::*;
+
+    #[test]
+    fn stable_rsa_verifies_openssl_sha256_signatures() {
+        // Generated with OpenSSL, independent of either Rust digest API.
+        let key = PublicKey::Rsa(
+            rsa::RsaPublicKey::from_public_key_der(include_bytes!(
+                "testdata/stable-rsa-public.der"
+            ))
+            .unwrap(),
+        );
+        let digest = Sha256::digest(b"YARA-X stable RSA compatibility regression\n");
+        assert!(
+            key.verify_digest::<Sha256>(digest, include_bytes!("testdata/stable-rsa-prefixed.sig"))
+        );
+        // Preserve upstream compatibility with old, unprefixed signatures.
+        assert!(
+            key.verify_digest::<Sha256>(
+                digest,
+                include_bytes!("testdata/stable-rsa-unprefixed.sig")
+            )
+        );
+        let wrong_digest = Sha256::digest(b"modified message");
+        assert!(!key.verify_digest::<Sha256>(
+            wrong_digest,
+            include_bytes!("testdata/stable-rsa-prefixed.sig")
+        ));
+        let mut corrupt = *include_bytes!("testdata/stable-rsa-prefixed.sig");
+        corrupt[0] ^= 1;
+        assert!(!key.verify_digest::<Sha256>(digest, &corrupt));
+    }
+}
